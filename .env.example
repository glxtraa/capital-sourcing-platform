# Copy to .env.local for local dev, or set these in Vercel's Project ->
# Settings -> Environment Variables for deployment. See README.md for
# where each of these comes from.

# Postgres connection string. Vercel Postgres or Neon both give you one of
# these when you attach a database to the project; use the POOLED
# connection string for DATABASE_URL if the provider distinguishes the two.
DATABASE_URL="postgresql://user:password@localhost:5432/capital_sourcing?schema=public"

# openrouter.ai -> Keys. One key covers every model used below — this is
# the one API key this app needs for all LLM calls (extraction, provider
# research incl. web search, and the lender benchmark).
OPENROUTER_API_KEY=""

# All three optional — see src/lib/openrouter.ts for the current defaults
# and the reasoning (price/context/quality tradeoffs, checked against
# https://openrouter.ai/api/v1/models at the time they were chosen — that
# list changes constantly, so re-check before assuming these are still the
# best value). Any OpenRouter model slug that supports `tools` and
# `structured_outputs` works here.
OPENROUTER_EXTRACTION_MODEL=""
OPENROUTER_RESEARCH_MODEL=""
OPENROUTER_BENCHMARK_MODEL=""

# Optional — "mistral-ocr" (default, $2/1,000 pages, handles scans/stamps/
# tables well) or "cloudflare-ai" (free, plain-text markdown conversion,
# lower quality on scanned or heavily-formatted documents).
OPENROUTER_PDF_ENGINE=""

# Vercel Blob: Project -> Storage -> Create Database -> Blob. NOT
# auto-injected under this exact name -- Vercel's Blob connection defaults
# to OIDC and only auto-injects BLOB_STORE_ID/BLOB_WEBHOOK_PUBLIC_KEY. Get
# the real value from the store's own page -> the ".env.local" tab next to
# its quickstart snippet, and set it here under this plain name yourself
# (see README.md "Environment variable troubleshooting").
BLOB_READ_WRITE_TOKEN=""

# Inngest: inngest.com -> create an app -> Event Keys / Signing Key. Only
# required in deployed environments; local dev can run without these using
# `npm run inngest:dev` (the Inngest Dev Server), which the SDK talks to
# automatically when NODE_ENV=development and these are unset.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# STUB auth (see src/lib/auth.ts) — replace with a real provider before any
# deployment holding actual confidential deal documents.
DEMO_ORG_ID="demo-org"

# A single shared password gating every page AND API route (except
# Inngest's own callback) behind a cookie -- see src/lib/site-auth.ts and
# src/middleware.ts. NOT a real auth system: its only job is stopping a
# stranger who finds the URL from burning your OpenRouter/Blob/Inngest
# usage. Leave unset and the app stays fully public, exactly as before.
SITE_PASSWORD=""
