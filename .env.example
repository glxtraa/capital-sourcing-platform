# Copy to .env.local for local dev, or set these in Vercel's Project ->
# Settings -> Environment Variables for deployment. See README.md for
# where each of these comes from.

# Postgres connection string. Vercel Postgres or Neon both give you one of
# these when you attach a database to the project; use the POOLED
# connection string for DATABASE_URL if the provider distinguishes the two.
DATABASE_URL="postgresql://user:password@localhost:5432/capital_sourcing?schema=public"

# console.anthropic.com -> API Keys. Needs web search enabled on the
# account for the provider-research agent to actually search the web
# (extraction and benchmarking work without it).
ANTHROPIC_API_KEY=""

# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=""

# Vercel Blob: Project -> Storage -> Create Database -> Blob. Vercel sets
# this automatically for deployed environments once you connect a Blob
# store to the project; you still need it locally via `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""

# Inngest: inngest.com -> create an app -> Event Keys / Signing Key. Only
# required in deployed environments; local dev can run without these using
# `npm run inngest:dev` (the Inngest Dev Server), which the SDK talks to
# automatically when NODE_ENV=development and these are unset.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# STUB auth (see src/lib/auth.ts) — replace with a real provider before any
# deployment holding actual confidential deal documents.
DEMO_ORG_ID="demo-org"
