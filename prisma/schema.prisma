// Capital Sourcing Platform — data model
//
// This mirrors the manual system's file-based conventions
// (Capital_Sourcing_System/providers_db/schema.md and each deal's Capital_Sourcing/*.json/*.md)
// as a real relational schema. Read schema.md alongside this file if you're porting logic —
// every enum and field here has a direct written counterpart in that document.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Deals — one per company/borrower situation, the productionized version of
// a "company folder" in the manual system (TISI_FM_Data_Room_2608/, CBS/, Coal/).
// ---------------------------------------------------------------------------

enum DealStatus {
  UPLOADING // files are being added, extraction not yet run
  EXTRACTING // extraction agent is running
  NEEDS_REVIEW // extraction complete, but has gaps a human should fill or confirm
  READY // deal spec confirmed, ready to match against providers
  MATCHING // matching/research agent is running
  RESEARCHING // a provider-database gap was found; research agent is filling it (feedback loop)
  COMPLETE // shortlist + gap analysis (+ optional term sheet) produced
  ARCHIVED
}

enum FinancingStructureType {
  POST_SHIPMENT_RECEIVABLES_DISCOUNTING
  PRE_SHIPMENT_PROCUREMENT_FINANCE
  PRE_EXPORT_BORROWING_BASE
  ENTERPRISE_SCF_REVERSE_FACTORING
  UNKNOWN // extraction couldn't confidently classify yet — surfaced for human input
}

model Deal {
  id          String     @id @default(cuid())
  orgId       String // multi-tenant scoping — see lib/auth.ts
  name        String // display name, e.g. "Favorite Medium Asia / TISI"
  status      DealStatus @default(UPLOADING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  documents      UploadedDocument[]
  parties        Party[]
  financingAsks  FinancingAsk[]
  riskFlags      RiskFlag[]
  providerMatches ProviderMatch[]
  researchRuns   ResearchRun[]
  termSheets     TermSheet[]

  // Free-form notes a human reviewer adds during NEEDS_REVIEW — feeds back into
  // the next extraction/matching pass rather than being a dead-end comment box.
  reviewerNotes String?
}

// ---------------------------------------------------------------------------
// The DSL, as relations. See src/dsl/schema.ts for the Zod mirror used at the
// API boundary (what the extraction agent must emit, validated before it ever
// reaches these tables).
// ---------------------------------------------------------------------------

enum PartyRole {
  BORROWER // the party seeking financing (called "seller" in some manual docs)
  OBLIGOR // the account debtor / buyer who ultimately pays
  SUPPLIER // upstream counterparty the borrower must pay (relevant for
  // PRE_SHIPMENT_PROCUREMENT_FINANCE / PRE_EXPORT_BORROWING_BASE deals)
  INTERMEDIARY // a permit-holder/trader sitting between a primary right-holder
  // and the borrower — chain-of-title risk lives here (see PT KEM's
  // IUP-OPK supplier in the worked examples)
  GUARANTOR
}

model Party {
  id           String    @id @default(cuid())
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  role         PartyRole
  legalName    String
  jurisdiction String?
  isListed     Boolean?
  publicRating String? // e.g. "JCR A+"
  bankName     String?
  bankAccount  String?
  notes        String?

  // Chain-of-title: for an INTERMEDIARY party, the primary right-holder it
  // actually sources from (e.g. the mining IUP holder behind a transport
  // permit-only supplier). Null unless role = INTERMEDIARY.
  primaryRightHolderName String?
  primaryRightHolderVerified Boolean @default(false)

  createdAt DateTime @default(now())
}

model FinancingAsk {
  id             String                 @id @default(cuid())
  dealId         String
  deal           Deal                   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  structureType  FinancingStructureType @default(UNKNOWN)
  amount         Float?
  currency       String? // ISO 4217, e.g. "USD", "IDR"
  advanceRatePct Float? // LTV-equivalent, where applicable
  tenorDaysMin   Int?
  tenorDaysMax   Int?
  tenorNote      String? // e.g. "provisional — transit time not yet confirmed"
  recurring      Boolean                @default(false)
  recurringNote  String?
  createdAt      DateTime               @default(now())
}

enum RiskFlagCategory {
  CHAIN_OF_TITLE // licensed-resource intermediary chain not yet verified
  CURRENCY_MISMATCH
  QUANTITY_OR_TERM_MISMATCH // two contracts in the same deal don't reconcile
  DOCUMENTARY_FRAUD_PATTERN // matches a known sector fraud shape (Hin Leong/
  // Radiant World/Churchill Mining-style)
  STALE_DEADLINE // a referenced financing teaser's own dates have passed
  MISSING_DOCUMENT
  PROMPT_INJECTION_SUSPECTED
  TAINTED_CLAIM_CONFLICT
  UNANCHORED_EXTRACTION
  OTHER
}

model RiskFlag {
  id                 String            @id @default(cuid())
  dealId             String
  deal               Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category           RiskFlagCategory
  severity           Int // 1 (low) - 5 (high) — used to sort the gap analysis / benchmark docs
  description        String
  resolvedAt         DateTime?
  verificationStatus String            @default("UNVERIFIED") // "UNVERIFIED" | "HUMAN_VERIFIED_SAFE" | "WAIVED_WITH_NOTES" | "HUMAN_CONFIRMED_RISK"
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationNotes  String?
  sourceFileName     String?
  evidenceSnippet    String?
  createdAt          DateTime          @default(now())
}

model UploadedDocument {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fileName    String
  blobUrl     String // Vercel Blob URL — see lib/blob.ts
  mimeType    String
  sizeBytes   Int
  // What the extraction agent read out of THIS specific file, before merging
  // into the deal-level Party/FinancingAsk/RiskFlag rows — kept for
  // provenance/audit ("which document said what").
  extractedFieldsRaw Json?
  // Standard Document Taxonomy code(s) this file satisfies (e.g. CORP_INCORP,
  // DEAL_CONTRACT), classified by the extraction agent -- used to check which
  // of a matched provider's documentsRequired are already covered by what's
  // been uploaded. Empty until extraction runs (or re-runs) after this field
  // was added.
  documentTypes String[] @default([])
  taintOverride String? // null (use DocumentTaintPolicy) | "AUDITED_PROOF" | "UNVERIFIED_CLAIM"
  uploadedAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Capital providers — the productionized providers.json. One shared table
// across every org (a provider's terms aren't confidential), matches are
// scoped per-deal.
// ---------------------------------------------------------------------------

enum ProviderType {
  BANK
  SPECIALIST_FACTOR
  MARKETPLACE
  ENTERPRISE_SCF_PLATFORM
  TRADE_FINANCE_FUND
  FAMILY_OFFICE // private capital with a published deal-sourcing intake (found by discovery)
  PRIVATE_CREDIT_FUND // non-bank direct lender / private credit manager
}

enum ProviderConfidence {
  VERIFIED_SITE
  VERIFIED_SECONDARY
  UNVERIFIED_NEEDS_CHECK
}

model Provider {
  id                          String               @id // stable slug, e.g. "incomlend" — ported directly from providers.json
  name                        String
  type                        ProviderType
  product                     String
  recourse                    String? // "recourse" | "non_recourse" | "both" | "not_applicable"
  sellerJurisdictions         String[] // "any" is a literal member when unrestricted
  obligorJurisdictions        String[]
  currencies                  String[]
  minTicketUsd                Float?
  maxTicketUsd                Float?
  typicalMinAnnualVolumeUsd   Float?
  gatingFactor                String?
  feeNotes                    String?
  applicationProcess          String?
  applicationUrl              String?
  contact                     String?
  timeToTermSheet             String?
  confidence                  ProviderConfidence  @default(UNVERIFIED_NEEDS_CHECK)
  lastVerified                DateTime?
  sources                     String[]
  notes                       String?
  financingStructuresSupported FinancingStructureType[]
  documentsRequired           ProviderDocumentRequirement[]
  matches                     ProviderMatch[]
  onboardings                 ProviderOnboarding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Standard Document Taxonomy — see schema.md for the full, authoritative list
// of codes (CORP_INCORP, DEAL_IUP_CHAIN, DEAL_LHV, etc.). Stored as a free
// string here rather than a Prisma enum so a new code can be added by the
// research agent without a schema migration.
model ProviderDocumentRequirement {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  code       String
  note       String?
}

enum MatchVerdict {
  GOOD
  POSSIBLE
  POOR
  EXCLUDED
}

model ProviderMatch {
  id          String       @id @default(cuid())
  dealId      String
  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  verdict     MatchVerdict
  rationale   String // freshly reasoned for THIS deal, never just copied from provider.notes
  isTier1     Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@unique([dealId, providerId])
}

// One row per agent run — extraction, matching, or provider research. This is
// what makes the "feedback to the AI agent in case more research is done"
// loop auditable: you can see exactly why a second research pass fired.
enum ResearchRunKind {
  EXTRACTION
  PROVIDER_MATCHING
  PROVIDER_RESEARCH_REFRESH // capital-provider-research, Mode A
  PROVIDER_RESEARCH_NEW // capital-provider-research, Mode B
  LENDER_BENCHMARK
}

enum ResearchRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  NEEDS_HUMAN_INPUT // e.g. extraction couldn't determine transit time — deal
  // moves to NEEDS_REVIEW instead of silently guessing
}

model ResearchRun {
  id          String            @id @default(cuid())
  dealId      String?
  deal        Deal?             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind        ResearchRunKind
  status      ResearchRunStatus @default(RUNNING)
  triggeredBy String // "user" | "system:low_confidence_match" | "system:stale_provider" | ...
  inputSummary String?
  outputSummary String?
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?
}

// The lender-benchmark skill's output, productionized.
model TermSheet {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  proposedRatePct Float?
  rateRationale   String?
  advanceRatePct  Float?
  tenorDaysMin    Int?
  tenorDaysMax    Int?
  tenorNote       String?
  currency        String?
  securityTerms   String?
  conditionsPrecedent String?
  benchmarkTableJson Json? // the alternative-provider comparison table
  leverageAssessment String? // Step 3 of the skill: how much pricing power the lender has
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Provider onboarding research + discovery of new providers (batch jobs).
// Everything the research agents produce lands in these tables as a PROPOSAL
// for a human to accept/reject -- nothing here overwrites a Provider row.
// ---------------------------------------------------------------------------

enum OnboardingStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  SUPERSEDED // an older ACCEPTED row replaced by a newer accepted one
}

// How to contact a provider and what an application needs, from official
// sources only. One row per research run (history is kept); the newest
// ACCEPTED row per provider is the current answer.
model ProviderOnboarding {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  taskId     String? // the ResearchTask that produced it

  status OnboardingStatus @default(PENDING_REVIEW)

  applicationRoute          String // ONLINE_FORM | EMAIL | RELATIONSHIP_MANAGER | BROKER | NONE_PUBLIC
  applicationUrl            String?
  accountRequiredBeforeForm Boolean?
  formFieldsVisibility      String // FULL | PARTIAL | NOT_VISIBLE -- how much of the form the agent could actually see
  contacts                  Json // [{channel, value, purpose, sourceUrl}] -- official channels only, verified against the findings text
  formFields                Json // [{label, required, step, note}] -- the data a form asks for, so it can be gathered beforehand
  documentsToPrepare        Json // [{code, note}] using the Standard Document Taxonomy
  steps                     String[]
  eligibilityChecks         String[]
  typicalTurnaround         String?
  confidence                ProviderConfidence
  sources                   String[]
  notes                     String?

  researchedAt DateTime  @default(now())
  reviewedAt   DateTime?

  @@index([providerId, status])
}

enum CandidateStatus {
  PENDING_REVIEW
  PROMOTED
  REJECTED
}

// A provider the discovery agent found that is not yet in the Provider table.
model ProviderCandidate {
  id                 String          @id @default(cuid())
  name               String
  normalizedName     String          @unique // lowercase alphanumerics only -- dedupe key
  websiteUrl         String?
  domain             String?
  suggestedType      String // a ProviderType name; free text until promoted
  description        String
  whySurfaced        String
  jurisdictionsHint  String[]
  sources            String[]
  status             CandidateStatus @default(PENDING_REVIEW)
  promotedProviderId String?
  taskId             String?
  discoveredAt       DateTime        @default(now())
}

enum ResearchTaskKind {
  ONBOARDING // contact + application research for one existing provider
  DISCOVERY // look for new providers of one category
  PROFILE // build a full Provider record for a promoted candidate
}

enum ResearchTaskStatus {
  QUEUED // nothing done yet
  SEARCHED // web-search step done (findings stored); structuring step pending
  DONE
  FAILED
}

model ResearchBatch {
  id          String         @id @default(cuid())
  label       String
  triggeredBy String // "user" | "cron"
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?
  tasks       ResearchTask[]
}

// One unit of batch work. Each step() call performs ONE model call (search or
// structure) so every request fits Vercel Hobby's 60s function cap.
model ResearchTask {
  id         String             @id @default(cuid())
  batchId    String
  batch      ResearchBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kind       ResearchTaskKind
  status     ResearchTaskStatus @default(QUEUED)
  providerId String? // ONBOARDING
  candidateId String? // PROFILE
  subject    String // human label: provider name or discovery category
  payload    Json? // DISCOVERY: {category, context}
  findings   String? // search-step output, kept between the two steps
  citedUrls  String[]
  attempts   Int                @default(0)
  lockedAt   DateTime? // set while a step runs; stale after 90s
  error      String?
  resultSummary String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([batchId, status])
}

// Tiny key/value store for app switches (e.g. "cronEnabled").
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Parallel Trade Finance Models
// ---------------------------------------------------------------------------

enum TradeDealStatus {
  UPLOADING
  EXTRACTING
  RECONCILING
  DIAGNOSING
  READY_TO_MATCH
  MATCHING
  RESEARCHING
  BENCHMARKING
  COMPLETE
  ARCHIVED
}

enum TradeCorridorEnum {
  IDN_COAL_ASIA
  SEA_AGRI_GLOBAL
  LATAM_SEAFOOD_ASIA
  OTHER_CROSS_BORDER
}

model TradeDeal {
  id              String            @id @default(cuid())
  orgId           String
  name            String
  corridor        TradeCorridorEnum @default(OTHER_CROSS_BORDER)
  status          TradeDealStatus   @default(UPLOADING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  parties         TradeParty[]
  contractLegs    ContractLeg[]
  financingAsks   TradeFinancingAskModel[]
  riskFlags       TradeRiskFlag[]
  documents       UploadedTradeDocument[]
  matches         TradeFunderMatchModel[]
  termSheets      TradeTermSheetModel[]
  researchRuns    TradeResearchRun[]
}

model TradeParty {
  id                        String    @id @default(cuid())
  dealId                    String
  deal                      TradeDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  role                      String    // "SUPPLIER" | "TRADER" | "BUYER"
  legalName                 String
  jurisdiction              String?
  concessionOrLicenseId     String?
  concessionVerified        Boolean   @default(false)
  bankName                  String?
  swiftBic                  String?
  createdAt                 DateTime  @default(now())
}

model ContractLeg {
  id                   String    @id @default(cuid())
  dealId               String
  deal                 TradeDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  legType              String    // "SUPPLY_LEG" | "OFFTAKE_LEG"
  contractReference    String
  sellerName           String
  buyerName            String
  incoterm             String
  port                 String
  paymentType          String
  tenorDays            Int
  amountUsd            Float
  commodityName        String
  quantity             Float
  unit                 String
  unitPrice            Float
  createdAt            DateTime  @default(now())
}

model TradeFinancingAskModel {
  id                String    @id @default(cuid())
  dealId            String
  deal              TradeDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  isUmbrella        Boolean   @default(false)
  leg               String?   // "SUPPLIER_LEG" | "TRADER_LEG" | "BUYER_LEG"
  targetEntityName  String
  instrument        String
  amountUsd         Float
  advanceRatePct    Float
  tenorDaysMin      Int
  tenorDaysMax      Int
  collateralSummary String?
  createdAt         DateTime  @default(now())
}

model TradeRiskFlag {
  id                 String    @id @default(cuid())
  dealId             String
  deal               TradeDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category           String
  severity           Int       // 1 - 5
  description        String
  resolved           Boolean   @default(false)
  verificationStatus String    @default("UNVERIFIED") // "UNVERIFIED" | "HUMAN_VERIFIED_SAFE" | "WAIVED_WITH_NOTES" | "HUMAN_CONFIRMED_RISK"
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationNotes  String?
  sourceFileName     String?
  evidenceSnippet    String?
  createdAt          DateTime  @default(now())
}

model UploadedTradeDocument {
  id          String    @id @default(cuid())
  dealId      String
  deal        TradeDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fileName    String
  blobUrl     String
  mimeType    String
  sizeBytes   Int
  tradeLeg    String?
  documentTypes String[] @default([])
  taintOverride String? // null (use DocumentTaintPolicy) | "AUDITED_PROOF" | "UNVERIFIED_CLAIM"
  extractedRaw  Json?
  uploadedAt  DateTime  @default(now())
}

model TradeFunder {
  id                          String    @id // stable slug e.g. "bni-trade-desk"
  name                        String
  type                        String
  offersUmbrellaFacility      Boolean   @default(false)
  supportedLegs               String[]
  supportedCorridors          String[]
  supportedCommodities        String[]
  excludedCommodities         String[]
  acceptedSupplierJurisdictions String[]
  acceptedTraderJurisdictions String[]
  acceptedBuyerJurisdictions   String[]
  minTicketUsd                Float?
  maxTicketUsd                Float?
  indicativePricingGuidance   String?
  gatingFactor                String?
  confidence                  String    @default("UNVERIFIED_NEEDS_CHECK")
  lastVerified                DateTime?
  sources                     String[]
  notes                       String?
  contact                     String?
  applicationUrl              String?
  rateEvidenceSnippet         String?
  pricingProvenance           Json?
  deskContacts                Json?
  documentsRequired           TradeFunderDocumentRequirement[]
  matches                     TradeFunderMatchModel[]
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model TradeFunderDocumentRequirement {
  id          String      @id @default(cuid())
  funderId    String
  funder      TradeFunder @relation(fields: [funderId], references: [id], onDelete: Cascade)
  code        String
  note        String?
}

model TradeFunderMatchModel {
  id          String      @id @default(cuid())
  dealId      String
  deal        TradeDeal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  funderId    String
  funder      TradeFunder @relation(fields: [funderId], references: [id], onDelete: Cascade)
  isUmbrella  Boolean     @default(false)
  verdict     String
  rationale   String
  isTier1     Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@unique([dealId, funderId])
}

model TradeTermSheetModel {
  id              String    @id @default(cuid())
  dealId          String
  deal            TradeDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  facilityType    String    // "UMBRELLA" | "MODULAR_SYNDICATE"
  leadFunderName  String
  facilityLimitUsd Float
  blendedPricing  Float
  pricingFormula  String
  advanceRatePct  Float
  tenorDaysMax    Int
  securityTerms   Json      // string array
  conditionsPrecedent Json  // string array
  benchmarkTableJson Json
  createdAt       DateTime  @default(now())
}

model TradeResearchRun {
  id          String    @id @default(cuid())
  dealId      String?
  deal        TradeDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)
  triggeredBy String
  status      String    @default("RUNNING")
  inputSummary String?
  outputSummary String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
}

// ---------------------------------------------------------------------------
// Parallel Startup VC Funding Models
// ---------------------------------------------------------------------------

enum StartupDealStatus {
  UPLOADING
  EXTRACTING
  RECONCILING
  READY_TO_MATCH
  MATCHING
  RESEARCHING
  BENCHMARKING
  COMPLETE
  ARCHIVED
}

enum StartupStage {
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  GROWTH
}

enum StartupSector {
  B2B_SAAS
  FINTECH
  AI_ML_INFRASTRUCTURE
  GENERATIVE_AI_APPS
  CLIMATETECH
  HEALTHTECH_BIOTECH
  DEV_TOOLS
  CYBERSECURITY
  MARKETPLACE_PLATFORM
  HARDWARE_ROBOTICS
  WEB3_CRYPTO
  CONSUMER
}

enum StartupInstrumentType {
  POST_MONEY_SAFE
  PRE_MONEY_SAFE
  CONVERTIBLE_NOTE
  PRICED_PREFERRED_EQUITY
  ACCELERATOR_STANDARD_TERMS
}

enum StartupInvestorType {
  INSTITUTIONAL_VC
  ANGEL_OPERATOR
  ANGEL_PLATFORM_SYNDICATE
  VC_PLATFORM_SCOUT
  ACCELERATOR_INCUBATOR
}

model StartupDeal {
  id                        String              @id @default(cuid())
  orgId                     String
  companyName               String
  stage                     StartupStage        @default(SEED)
  primaryVertical           StartupSector       @default(B2B_SAAS)
  industry                  String?             // e.g. "Cross-Border Trade Infrastructure & B2B Payments"
  subIndustries             String[]            @default([])
  targetCustomerProfile     String?
  businessModel             String?
  legalEntityJurisdiction   String?
  status                    StartupDealStatus   @default(UPLOADING)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  founders                  StartupFounder[]
  capTable                  StartupCapTable?
  financingAsks             StartupFinancingAsk[]
  riskFlags                 StartupRiskFlag[]
  competitors               StartupCompetitor[]
  commercialProspects       StartupCommercialProspect[]
  documents                 UploadedStartupDocument[]
  matches                   StartupInvestorMatch[]
  syndicateBlueprints       StartupSyndicateBlueprint[]
  researchRuns              StartupResearchRun[]
}

model StartupCommercialProspect {
  id                        String       @id @default(cuid())
  dealId                    String
  deal                      StartupDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name                      String
  websiteUrl                String?
  category                  String       @default("ENTERPRISE_CUSTOMER") // ENTERPRISE_CUSTOMER | SMB_CUSTOMER_SEGMENT | STRATEGIC_CHANNEL_PARTNER | INTEGRATION_ALLIANCE | DATA_OR_SUPPLY_PARTNER
  buyerPersona              String?
  useCaseFit                String
  estimatedAcvTier          String       @default("25K_TO_100K")
  strategicSynergy          String?
  sourceUrl                 String?
  sourceVerified            Boolean      @default(false)
  sourceHttpStatus          Int?
  lastVerified              DateTime?
  contacts                  StartupProspectContact[]
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([dealId])
}

model StartupProspectContact {
  id                        String       @id @default(cuid())
  prospectId                String
  prospect                  StartupCommercialProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  fullName                  String
  title                     String
  roleCategory              String       @default("DECISION_MAKER") // DECISION_MAKER | PROCUREMENT_LEAD | TECHNICAL_EVALUATOR | CHAMPION
  department                String?
  linkedinUrl               String?
  emailPattern              String?
  location                  String?
  relevanceRationale        String?
  outreachAngle             String?
  sourceUrl                 String?
  sourceVerified            Boolean      @default(false)
  sourceHttpStatus          Int?
  lastVerified              DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([prospectId])
}

model StartupCompetitor {
  id                        String       @id @default(cuid())
  dealId                    String
  deal                      StartupDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name                      String
  websiteUrl                String?
  description               String
  overlapDegree             String       @default("DIRECT") // "DIRECT" | "INDIRECT" | "ADJACENT"
  knownInvestors            String[]     @default([])
  differentiation           String?
  sourceUrl                 String?
  sourceVerified            Boolean      @default(false)
  sourceHttpStatus          Int?
  lastVerified              DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
}

model StartupFounder {
  id                        String       @id @default(cuid())
  dealId                    String
  deal                      StartupDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name                      String
  role                      String       // "CEO", "CTO", "COO", "Founder"
  isTechnical               Boolean      @default(false)
  isRepeatFounder           Boolean      @default(false)
  equityOwnershipPct        Float
  vestingConfirmed          Boolean      @default(true)
  linkedinUrl               String?
  priorExits                String[]     @default([])
  createdAt                 DateTime     @default(now())
}

model StartupCapTable {
  id                        String       @id @default(cuid())
  dealId                    String       @unique
  deal                      StartupDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  foundersOwnershipPct      Float?
  investorOwnershipPct      Float?
  optionPoolPct             Float?
  safesNotesOutstandingUsd  Float        @default(0)
  safeHoldersJson           Json?
  commonHoldersJson         Json?
  hasDeadEquity             Boolean      @default(false)
  deadEquityNotes           String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
}

model StartupFinancingAsk {
  id                        String                  @id @default(cuid())
  dealId                    String
  deal                      StartupDeal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  targetRaiseUsd            Float?
  instrumentType            StartupInstrumentType?
  valuationCapUsd           Float?
  discountPct               Float?
  plannedRunwayMonths       Int?
  leadCommitted             Boolean                 @default(false)
  committedAmountUsd        Float                   @default(0)
  useOfProceedsJson         Json?
  createdAt                 DateTime                @default(now())
}

model StartupRiskFlag {
  id                        String       @id @default(cuid())
  dealId                    String
  deal                      StartupDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category                  String
  severity                  Int          // 1 - 5
  description               String
  resolved                  Boolean      @default(false)
  verificationStatus        String       @default("UNVERIFIED") // "UNVERIFIED" | "HUMAN_VERIFIED_SAFE" | "WAIVED_WITH_NOTES" | "HUMAN_CONFIRMED_RISK"
  verifiedBy                String?
  verifiedAt                DateTime?
  verificationNotes         String?
  sourceFileName            String?
  evidenceSnippet           String?
  createdAt                 DateTime     @default(now())
}

model UploadedStartupDocument {
  id                        String       @id @default(cuid())
  dealId                    String
  deal                      StartupDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fileName                  String
  blobUrl                   String
  mimeType                  String
  sizeBytes                 Int
  documentTypes             String[]     @default([])
  taintOverride             String?      // null (use DocumentTaintPolicy) | "AUDITED_PROOF" | "UNVERIFIED_CLAIM"
  extractedRaw              Json?
  uploadedAt                DateTime     @default(now())
}

model StartupInvestor {
  id                        String              @id // stable slug e.g. "sequoia-seed"
  name                      String
  type                      StartupInvestorType
  targetStages              StartupStage[]
  preferredSectors          StartupSector[]
  excludedSectors           StartupSector[]     @default([])
  minCheckUsd               Float?
  maxCheckUsd               Float?
  sweetSpotCheckUsd         Float?
  leadsRounds               Boolean             @default(false)
  takesBoardSeats           Boolean             @default(false)
  targetOwnershipPct        Float?
  acceptedJurisdictions     String[]            @default([])
  minArrUsd                 Float?
  portfolioCompanies        String[]            @default([])
  activelyFundingIndustry   Boolean             @default(true)
  recentIndustryInvestments Json?               // Array of { companyName, dealYear, roundStage, sector, sourceUrl, verified }
  competitorInvestments     Json?               // Array of { competitorName, roundStage, conflictSeverity, notes, sourceUrl, verified }
  thesisMatchSummary        String?
  sourceLinksAudit          Json?               // Array of { url, status, ok, latencyMs, testedAt }
  criteriaProvenance        Json?               // Array of CriterionRuleProvenance
  gatingFactor              String?
  typicalTurnaroundWeeks    Int?
  applicationRoute          String              @default("WARM_INTRO") // "OPEN_PORTAL", "SCOUT_FORM", "WARM_INTRO", "ACCELERATOR_COHORT"
  applicationUrl            String?
  confidence                String              @default("VERIFIED_SECONDARY")
  sources                   String[]            @default([])
  notes                     String?
  contactEmail              String?
  headquarters              String?
  websiteUrl                String?
  keyContactsJson           Json?               // Array of { name, role, email, linkedinUrl, twitterUrl, verified }
  lastVerified              DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  documentsRequired         StartupInvestorDocumentRequirement[]
  matches                   StartupInvestorMatch[]
}

model StartupInvestorDocumentRequirement {
  id                        String          @id @default(cuid())
  investorId                String
  investor                  StartupInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  code                      String
  note                      String?
}

model StartupInvestorMatch {
  id                          String          @id @default(cuid())
  dealId                      String
  deal                        StartupDeal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  investorId                  String
  investor                    StartupInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  tier                        String          // "TIER_1_LEAD" | "TIER_2_SYNDICATE" | "TIER_3_ANGEL" | "TIER_4_ACCELERATOR"
  verdict                     String          // "GOOD" | "POSSIBLE" | "POOR" | "EXCLUDED"
  rationale                   String
  isLeadCandidate             Boolean         @default(false)
  thesisResonanceScore        Float?
  portfolioConflictDetected   Boolean         @default(false)
  conflictingPortfolioCompany String?
  activelyFundingIndustry     Boolean         @default(true)
  industryDeploymentScore     Float?          @default(85)
  competitorConflictNotes     String?
  sourceLinksAudit            Json?
  createdAt                   DateTime        @default(now())

  @@unique([dealId, investorId])
}

model StartupSyndicateBlueprint {
  id                        String       @id @default(cuid())
  dealId                    String
  deal                      StartupDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  targetRaiseUsd            Float
  leadAllocationUsd         Float
  syndicateAllocationUsd    Float
  angelAllocationUsd        Float
  recommendedValuationCapUsd Float?
  dilutionModelJson         Json
  synthesisSummary          String
  createdAt                 DateTime     @default(now())
}

model StartupResearchRun {
  id                        String       @id @default(cuid())
  dealId                    String?
  deal                      StartupDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)
  triggeredBy               String
  status                    String       @default("RUNNING")
  inputSummary              String?
  outputSummary             String?
  startedAt                 DateTime     @default(now())
  finishedAt                DateTime?
}

// ---------------------------------------------------------------------------
// Research Page Cache — stores verified snapshots of web pages cited during
// VC, Trade, and Invoice provider research for unassailable auditability.
// ---------------------------------------------------------------------------

model ResearchPageCache {
  id             String    @id @default(cuid())
  url            String    @unique
  normalizedUrl  String
  title          String?
  content        String    @db.Text
  snippet        String?   @db.Text
  httpStatus     Int       @default(200)
  contentType    String?
  byteSize       Int       @default(0)
  headersJson    Json?
  fetchLatencyMs Int       @default(0)
  cachedAt       DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([normalizedUrl])
  @@index([cachedAt])
}

// ---------------------------------------------------------------------------
// Editable Document Taint Policy — maps Document Taxonomy codes across all 3
// asset classes ("INVOICE", "TRADE", "VC") to AUDITED_PROOF or UNVERIFIED_CLAIM.
// ---------------------------------------------------------------------------

model DocumentTaintPolicy {
  id           String   @id @default(cuid())
  assetClass   String   // "INVOICE" | "TRADE" | "VC"
  taxonomyCode String   // e.g. "VC_PITCH_DECK", "VC_CAP_TABLE", "TRADE_OCEAN_BILL_OF_LADING", "DEAL_CONTRACT"
  label        String   // Human-readable label
  defaultTaint String   @default("UNVERIFIED_CLAIM") // "AUDITED_PROOF" | "UNVERIFIED_CLAIM"
  updatedBy    String?
  updatedAt    DateTime @updatedAt

  @@unique([assetClass, taxonomyCode])
}

// ---------------------------------------------------------------------------
// Persistent DSL Revision & Rollback Engine — tracks every agent extraction
// and human override version of deal specifications, extractions, and matching
// inputs across all 3 asset classes with notes and instant rollback.
// ---------------------------------------------------------------------------

model DealDslRevision {
  id            String   @id @default(cuid())
  assetClass    String   // "STARTUP" | "TRADE" | "INVOICE"
  dealId        String   // ID of deal in whichever asset class
  tabKey        String   // "dataroom" | "spec" | "matching" | "blueprint"
  dslType       String   // "STARTUP_DEAL_SPEC" | "TRADE_DEAL_SPEC" | "INVOICE_DEAL_SPEC" | "EXTRACTION_PAYLOAD"
  versionNumber Int      // 1, 2, 3...
  label         String   // e.g. "v2 - Human Correction: Water Domain"
  authorType    String   // "AGENT_EXTRACTION" | "HUMAN_OVERRIDE" | "ROLLBACK_RESTORE"
  authorNote    String?  // Human operator rationale or agent summary
  payloadJson   Json     // Full snapshot of the DSL payload
  diffSummary   String?  // Human readable summary of what changed
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([dealId, tabKey])
  @@index([dealId, dslType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Autonomous Agent Feedback & Prompt Improvement Suggestions — records
// DSL Grounding Gate rejections and LLM structural errors so prompt engineers
// and self-improving meta-agents can audit failure patterns without breaking
// the user interface.
// ---------------------------------------------------------------------------

model PromptImprovementSuggestion {
  id              String   @id @default(cuid())
  agentType       String   // "INVOICE_RESEARCH" | "TRADE_RESEARCH" | "VC_RESEARCH" | "EXTRACTION"
  promptId        String   // "research.md" | "trade-research.md" | "vc-research.md" | "extraction.md"
  triggerEvent    String   // "DSL_GROUNDING_GATE_REJECTION" | "LINK_AUDIT_FAILURE" | "SCHEMA_VALIDATION_FAILURE"
  failedInput     String?  @db.Text
  rejectionReason String   @db.Text
  suggestedRule   String   @db.Text
  contextJson     Json?
  status          String   @default("OPEN") // "OPEN" | "REVIEWED" | "APPLIED" | "DISMISSED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentType])
  @@index([promptId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Agent Execution Trials — persistent log of every agent trial/attempt,
// recording intermediate failures, hallucinated candidates, DSL Grounding
// Gate rejections, corrective prompts, and recovery outcomes.
// ---------------------------------------------------------------------------

model AgentExecutionTrial {
  id               String   @id @default(cuid())
  runId            String?
  dealId           String?
  assetClass       String   // "INVOICE" | "TRADE" | "VC"
  stage            String   // "RESEARCH_STRUCTURE" | "RESEARCH_SEARCH" | "DOCUMENT_EXTRACTION"
  trialNumber      Int      // 1, 2, 3...
  status           String   // "SUCCESS" | "FAILED_GATE" | "FAILED_SCHEMA" | "FAILED_HTTP" | "RETRYING"
  entityName       String?
  inputSummary     String?  @db.Text
  extractedPayload Json?
  failureReason    String?  @db.Text
  promptFeedback   String?  @db.Text
  diagnosticsJson  Json?
  modelSlug        String?
  durationMs       Int?
  createdAt        DateTime @default(now())

  @@index([dealId])
  @@index([runId])
  @@index([assetClass, stage])
  @@index([status])
  @@index([createdAt])
}


